# ---------------------------------------------------------------------------
# NutriAdd backend environment variables.
# Copy to `.env` and fill in real values. On the Azure VM, keep this file
# readable only by the service user:  chmod 600 .env
# ---------------------------------------------------------------------------

# Database — Azure Database for MySQL Flexible Server (async driver: aiomysql).
# Local development against a local MySQL:
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/nutriadd
# Production (Azure MySQL Flexible Server). TLS is applied automatically for any
# non-localhost host — no ?ssl= flag needed in the URL. Example:
# DATABASE_URL=mysql+aiomysql://nutriadd_app:CHANGE_ME@nutriadd-db.mysql.database.azure.com:3306/nutriadd

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — comma-separated (or JSON array) list of allowed frontend origins.
# Must include every domain the site is served from. No trailing slashes, no quotes.
CORS_ORIGINS=http://localhost:5173,https://nutriadd.store,https://www.nutriadd.store,https://nutriadd.vercel.app

# Media storage — files are written to MEDIA_ROOT on disk and served by Nginx at
# MEDIA_BASE_URL/media/... The DB only stores the resulting HTTPS URL, never binary.
# The service user must own/write MEDIA_ROOT (e.g. chown -R nutriadd /var/www/nutriadd/media).
MEDIA_ROOT=/var/www/nutriadd/media
MEDIA_BASE_URL=https://api.nutriadd.store
MEDIA_PRODUCT_DIR=products
MEDIA_PROMO_DIR=promo

# NOTE: Azure Blob Storage is no longer used — media lives on the VPS disk (above).
# Any leftover AZURE_STORAGE_* lines below are ignored and can be deleted.

# App
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Resend (transactional email) — currently consumed by the frontend's
# /api/contact serverless function (configured in Vercel, not here) and by the
# backend's stubbed password-reset hook. Set here only once the backend actually
# sends email (see app/services/auth_service.py::send_reset_email TODO).
# RESEND_API_KEY=
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Transactional email (SMTP) — order confirmation to the customer + a
# notification to your business inbox. Credentials come from here (never
# hardcoded). If SMTP_HOST is blank, emails are LOGGED instead of sent, so
# order creation still works without email configured.
# For Hostinger business email, typical values:
#   SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465  SMTP_USE_SSL=true  SMTP_USE_TLS=false
#   (or PORT=587 with SMTP_USE_TLS=true / SMTP_USE_SSL=false for STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=info@nutriadd.store
EMAIL_FROM_NAME=NutriAdd
# Your business mailbox that gets a copy of every new order:
ORDER_NOTIFY_EMAIL=info@nutriadd.store
# Public site URL used to build order links in emails:
SITE_URL=https://nutriadd.store
